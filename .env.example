# Public application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Supabase server access (never expose this value to the browser)
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Commerce safety gates
COMMERCE_SANDBOX_MODE=true
COMMERCE_DEMO_CATALOG=true
COMMERCE_CHECKOUT_ENABLED=false

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Canada Post test app (REST/JSON + OAuth 2.0)
CANADA_POST_API_KEY=replace_me
CANADA_POST_API_SECRET=replace_me
CANADA_POST_ENVIRONMENT=test
CANADA_POST_ACCOUNT_TYPE=
CANADA_POST_CUSTOMER_NUMBER=
CANADA_POST_MOBO_CUSTOMER_NUMBER=
CANADA_POST_CONTRACT_ID=
CANADA_POST_GROUP_ID=
CANADA_POST_API_BASE=https://api.canadapost-postescanada.ca/prod/devportal-portaildesdeveloppeurs

# Transactional email
RESEND_API_KEY=re_test_replace_me
EMAIL_FROM=Wander Bike <orders@example.com>
ORDER_NOTIFICATION_EMAIL=orders@example.com

# Scheduled job authentication
CRON_SECRET=replace_with_a_random_secret
